            "modifiers": {
              "mandatory": [
                "right_command",
                "left_command"
              ]
            }
          },
          "to": [
            {
              "shell_command": "export LC_ALL=en_US.UTF-8; printf \"α\" | pbcopy"
            },
            {
              "key_code": "vk_none",
              "hold_down_milliseconds": 100
            },
            {
              "key_code": "v",
              "modifiers": [
                "left_command"
              ]
            }
