  "import_url": null,
  "gallery_url": null,
  "repo": null,
  "rules": [
    {
      "description": "Caps Lock to Control (tap for Escape)",
      "manipulators": [
        {
          "description": "capslock = esc(click) | right control(hold)",
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_control"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ]
        }
      ]
    },
    {
      "description": "Tab to Meh",
      "manipulators": [
        {
          "description": "tab = tab(click) | meh(hold)",
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": [
                "left_control",
                "left_option"
              ]
            }
          ],
          "to_if_alone": [
            {
              "key_code": "tab"
            }
          ]
        }
      ]
    },
    {
      "description": "Escape to Control",
      "manipulators": [
        {
          "description": "Escape = control",
          "type": "basic",
          "from": {
            "key_code": "escape"
          },
          "to": [
            {
              "key_code": "left_control"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper Shifting",
      "manipulators": [
        {
          "description": "space + ) = ) + space (only just after pressing right shift)",
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "mandatory": [
                "right_shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "0",
              "modifiers": [
                "right_shift"
              ]
            },
            {
              "key_code": "spacebar"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "rshift_fresh",
              "value": 1
            }
          ]
        },
        {
          "description": "Left shift = (",
          "type": "basic",
          "from": {
            "key_code": "left_shift"
          },
          "to": [
            {
              "key_code": "left_shift"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "9",
              "modifiers": [
                "left_shift"
              ]
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          }
        },
        {
          "description": "Right shift = )",
          "type": "basic",
          "from": {
            "key_code": "right_shift"
          },
          "to": [
            {
              "set_variable": {
                "name": "rshift_fresh",
                "value": 1
              }
            },
            {
              "key_code": "right_shift"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "0",
              "modifiers": [
                "right_shift"
              ]
            }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              {
                "set_variable": {
                  "name": "rshift_fresh",
                  "value": 0
                }
              }
            ],
            "to_if_canceled": [
              {
                "set_variable": {
                  "name": "rshift_fresh",
                  "value": 0
                }
              }
            ]
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200,
            "basic.to_delayed_action_delay_milliseconds": 150
          }
        },
        {
          "description": "Shift rolls: )(",
          "type": "basic",
          "from": {
            "key_code": "left_shift",
            "modifiers": {
              "mandatory": [
                "right_shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_shift"
            },
            {
              "key_code": "right_shift"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "0",
              "modifiers": [
                "right_shift",
                "left_shift"
              ]
            },
            {
              "key_code": "9",
              "modifiers": [
                "right_shift",
                "left_shift"
              ]
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          }
        },
        {
          "description": "Shift rolls: ()",
          "type": "basic",
          "from": {
            "key_code": "right_shift",
            "modifiers": {
              "mandatory": [
                "left_shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_shift"
            },
            {
              "key_code": "left_shift"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "9",
              "modifiers": [
                "right_shift"
              ]
            },
            {
              "key_code": "0",
              "modifiers": [
                "right_shift"
              ]
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          }
        }
      ]
    },
