          "from": {
            "key_code": "left_command",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_option",
                "right_shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_command",
              "modifiers": [
                "right_control"
              ]
            }
          ]
        },
        {
          "description": "Capslock + Option = Control + Command (Reverse)",
          "type": "basic",
          "from": {
            "key_code": "left_option",
            "modifiers": {
              "mandatory": [
